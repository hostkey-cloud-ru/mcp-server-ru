{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hostkey-cloud-ru/mcp-server-ru",
  "description": "MCP-сервер Hostkey .ru (InvAPI): серверы, питание, заказ, DNS, S3, биллинг",
  "version": "1.0.2",
  "repository": {
    "url": "https://github.com/hostkey-cloud-ru/mcp-server-ru",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.hostkey.ru/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <InvAPI API key> для портала .ru (invapi.hostkey.ru)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "hostkey-mcp-server-ru",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "HOSTKEY_API_KEY",
          "description": "InvAPI API key for the .ru portal (invapi.hostkey.ru); per-server keys supported",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "HOSTKEY_TOKEN_TTL",
          "description": "Session token TTL in seconds (default 3600)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "HOSTKEY_ALLOW_DESTRUCTIVE",
          "description": "Set to 1 to allow destructive operations (OS reinstall, PXE cycle, service cancellation)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
