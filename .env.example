# Required for stdio; for HTTP also accepted via Authorization: Bearer
HOSTKEY_API_KEY=your-api-key

# Transport: stdio (default) | http
MODE=stdio
# HTTP bind (MODE=http)
HOST=0.0.0.0
PORT=8080

# Browser CORS (MODE=http). Comma-separated origins, or "*".
# Default: https://ollama.hostkey.com,https://ollama.hostkey.ru
# HOSTKEY_CORS_ORIGINS=https://ollama.hostkey.ru

# Rate limit for /mcp (MODE=http). /health is not limited.
# HOSTKEY_RATE_LIMIT_WINDOW_MS=60000
# HOSTKEY_RATE_LIMIT_MAX=120

# Optional
HOSTKEY_TOKEN_TTL=3600
HOSTKEY_HTTP_TIMEOUT=60
HOSTKEY_ALLOW_DESTRUCTIVE=0
